<%- include('../partials/header', { title: title }) %>

<div class="flex bg-surface min-h-screen">
  <%- include('./partials/sidebar') %>

  <main class="flex-1 flex flex-col min-h-screen w-full">
    <div class="pt-10 px-6 md:px-12 pb-24 max-w-7xl mx-auto w-full">

      <!-- Header Section -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div>
          <h1 class="font-headline text-4xl md:text-5xl text-on-surface mb-2">Shop Analytics</h1>
          <p class="font-body text-on-secondary-container text-sm tracking-wide">Reviewing performance metrics for your artisan studio.</p>
        </div>
        <div class="flex items-center gap-4">
          <div class="relative bg-surface-container-lowest rounded-md shadow-[0px_20px_40px_rgba(25,28,30,0.06)] p-1 flex">
            <a href="?period=7" class="px-4 py-2 text-sm font-medium transition-colors rounded <%= selectedPeriod === 7 ? 'bg-surface-container-low text-on-surface ring-1 ring-inset ring-outline-variant/20' : 'text-on-secondary-container hover:text-on-surface' %>">7 Days</a>
            <a href="?period=30" class="px-4 py-2 text-sm font-medium transition-colors rounded <%= selectedPeriod === 30 ? 'bg-surface-container-low text-on-surface ring-1 ring-inset ring-outline-variant/20' : 'text-on-secondary-container hover:text-on-surface' %>">30 Days</a>
            <a href="?period=90" class="px-4 py-2 text-sm font-medium transition-colors rounded <%= selectedPeriod === 90 ? 'bg-surface-container-low text-on-surface ring-1 ring-inset ring-outline-variant/20' : 'text-on-secondary-container hover:text-on-surface' %>">90 Days</a>
          </div>
        </div>
      </div>

      <%
        // ── Chart data preparation ──────────────────────────────────────────
        let svgPath = 'M0,80 Q10,70 20,75 T40,50 T60,60 T80,30 T100,10';
        let svgFill = svgPath + ' L100,100 L0,100 Z';
        let chartPoints = [];
        let xAxisLabels = [];
        let yAxisLabels = ['$600','$400','$200','$0'];
        let highlightPoints = [];

        if (dailyRevenue && dailyRevenue.length > 0) {
          const maxRev = Math.max(...dailyRevenue.map(d => d.revenue));
          const pts = dailyRevenue.map(function(d, i) {
            const x = dailyRevenue.length === 1 ? 50 : (i / (dailyRevenue.length - 1)) * 100;
            const y = maxRev > 0 ? 10 + (1 - d.revenue / maxRev) * 80 : 80;
            return { x: x.toFixed(2), y: y.toFixed(2), day: d.day, revenue: d.revenue };
          });
          svgPath = 'M' + pts.map(p => p.x + ',' + p.y).join(' L');
          svgFill = svgPath + ' L100,100 L0,100 Z';
          chartPoints = pts;

          // Pick up to 5 evenly distributed highlight points
          const step = Math.max(1, Math.floor(pts.length / 3));
          [0, step, step*2, pts.length-1].filter((v,i,a)=>a.indexOf(v)===i && v < pts.length).forEach(function(idx) {
            highlightPoints.push(pts[idx]);
          });

          // X-axis labels
          const labelIdxs = [0, Math.floor(pts.length*0.25), Math.floor(pts.length*0.5), Math.floor(pts.length*0.75), pts.length-1];
          xAxisLabels = [...new Set(labelIdxs)].map(function(idx) {
            const d = dailyRevenue[idx];
            const dt = new Date(d.day);
            return dt.toLocaleDateString('en-US', { month:'short', day:'numeric' });
          });

          // Y-axis labels
          const step4 = Math.round(maxRev / 3);
          yAxisLabels = ['$'+Math.round(maxRev), '$'+Math.round(maxRev*2/3), '$'+step4, '$0'];
        }
      %>

      <!-- Metrics Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        <!-- Revenue -->
        <div class="bg-surface-container-lowest rounded-xl p-6 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col justify-between">
          <div class="flex justify-between items-start mb-4">
            <h3 class="font-label text-xs uppercase tracking-widest text-on-secondary-container">Total Revenue</h3>
            <div class="bg-tertiary-container/20 text-tertiary p-2 rounded-full">
              <span class="material-symbols-outlined text-[20px]">payments</span>
            </div>
          </div>
          <div>
            <div class="font-headline text-3xl text-on-surface mb-2">$<%= Number(periodStats.revenue || 0).toFixed(2) %></div>
            <% if (periodStats.revChg !== null && periodStats.revChg !== undefined) { %>
              <div class="flex items-center gap-1 text-sm font-body <%= periodStats.revChg >= 0 ? 'text-primary' : 'text-tertiary' %>">
                <span class="material-symbols-outlined text-[16px]"><%= periodStats.revChg >= 0 ? 'trending_up' : 'trending_down' %></span>
                <span class="font-medium"><%= periodStats.revChg >= 0 ? '+' : '' %><%= periodStats.revChg %>%</span>
                <span class="text-on-surface-variant ml-1">vs last period</span>
              </div>
            <% } else { %>
              <div class="flex items-center gap-1 text-sm font-body text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px]">horizontal_rule</span>
                <span class="font-medium">No prior data</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Orders -->
        <div class="bg-surface-container-lowest rounded-xl p-6 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col justify-between">
          <div class="flex justify-between items-start mb-4">
            <h3 class="font-label text-xs uppercase tracking-widest text-on-secondary-container">Total Orders</h3>
            <div class="bg-secondary-container/30 text-secondary p-2 rounded-full">
              <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
            </div>
          </div>
          <div>
            <div class="font-headline text-3xl text-on-surface mb-2"><%= periodStats.orders || 0 %></div>
            <% if (periodStats.ordChg !== null && periodStats.ordChg !== undefined) { %>
              <div class="flex items-center gap-1 text-sm font-body <%= periodStats.ordChg >= 0 ? 'text-primary' : 'text-tertiary' %>">
                <span class="material-symbols-outlined text-[16px]"><%= periodStats.ordChg >= 0 ? 'trending_up' : 'trending_down' %></span>
                <span class="font-medium"><%= periodStats.ordChg >= 0 ? '+' : '' %><%= periodStats.ordChg %>%</span>
                <span class="text-on-surface-variant ml-1">vs last period</span>
              </div>
            <% } else { %>
              <div class="flex items-center gap-1 text-sm font-body text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px]">horizontal_rule</span>
                <span class="font-medium">No prior data</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- AOV -->
        <div class="bg-surface-container-lowest rounded-xl p-6 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col justify-between">
          <div class="flex justify-between items-start mb-4">
            <h3 class="font-label text-xs uppercase tracking-widest text-on-secondary-container">Average Order Value</h3>
            <div class="bg-surface-container-highest text-on-surface-variant p-2 rounded-full">
              <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            </div>
          </div>
          <div>
            <div class="font-headline text-3xl text-on-surface mb-2">$<%= Number(periodStats.aov || 0).toFixed(2) %></div>
            <% if (periodStats.aovChg !== null && periodStats.aovChg !== undefined) { %>
              <div class="flex items-center gap-1 text-sm font-body <%= periodStats.aovChg >= 0 ? 'text-primary' : 'text-tertiary' %>">
                <span class="material-symbols-outlined text-[16px]"><%= periodStats.aovChg >= 0 ? 'trending_up' : 'trending_down' %></span>
                <span class="font-medium"><%= periodStats.aovChg >= 0 ? '+' : '' %><%= periodStats.aovChg %>%</span>
                <span class="text-on-surface-variant ml-1">vs last period</span>
              </div>
            <% } else { %>
              <div class="flex items-center gap-1 text-sm font-body text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px]">horizontal_rule</span>
                <span class="font-medium">Stable</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Store Views -->
        <div class="bg-surface-container-lowest rounded-xl p-6 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col justify-between">
          <div class="flex justify-between items-start mb-4">
            <h3 class="font-label text-xs uppercase tracking-widest text-on-secondary-container">Store Views</h3>
            <div class="bg-surface-container-highest text-on-surface-variant p-2 rounded-full">
              <span class="material-symbols-outlined text-[20px]">visibility</span>
            </div>
          </div>
          <div>
            <div class="font-headline text-3xl text-on-surface mb-2">
              <% const viewsNum = periodStats.views || 0; %>
              <%= viewsNum >= 1000 ? (viewsNum / 1000).toFixed(1) + 'k' : viewsNum %>
            </div>
            <div class="flex items-center gap-1 text-sm font-body text-on-surface-variant">
              <span class="material-symbols-outlined text-[16px]">bar_chart</span>
              <span class="font-medium">All-time views</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">

        <!-- Revenue Growth Chart -->
        <div class="lg:col-span-2 bg-surface-container-lowest rounded-xl p-8 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col">
          <div class="flex justify-between items-center mb-8">
            <div>
              <h2 class="font-headline text-2xl text-on-surface">Revenue Growth</h2>
              <p class="font-body text-sm text-on-secondary-container mt-1">Daily revenue over the selected <%= selectedPeriod %>-day period.</p>
            </div>
          </div>

          <!-- Chart layout: flex column so x-axis sits naturally below the chart -->
          <div class="flex flex-col" style="min-height:300px; flex:1">
            <!-- Row: y-axis + chart area -->
            <div class="flex flex-1 min-h-0">
              <!-- Y-Axis -->
              <div class="flex flex-col justify-between text-xs font-label text-on-surface-variant text-right pr-3 border-r border-outline-variant/20 flex-shrink-0" style="width:3.5rem; padding-bottom:0">
                <% yAxisLabels.forEach(function(lbl) { %><span><%= lbl %></span><% }); %>
              </div>
              <!-- SVG + tooltip wrapper -->
              <div id="chart-wrapper" class="flex-1 relative cursor-crosshair" style="min-height:260px">
                <!-- Grid lines -->
                <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
                  <div class="w-full border-b border-outline-variant/10"></div>
                  <div class="w-full border-b border-outline-variant/10"></div>
                  <div class="w-full border-b border-outline-variant/10"></div>
                  <div class="w-full border-b border-outline-variant/10"></div>
                </div>
                <!-- SVG line chart -->
                <svg class="w-full h-full" id="revenue-svg" preserveAspectRatio="none" viewBox="0 0 100 100" style="display:block">
                  <defs>
                    <linearGradient id="amber-gradient" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="#855300"/>
                      <stop offset="100%" stop-color="#f7f9fb" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d="<%= svgPath %>" fill="none" stroke="#855300" stroke-width="2" vector-effect="non-scaling-stroke"/>
                  <path d="<%= svgFill %>" fill="url(#amber-gradient)" opacity="0.2"/>
                  <!-- hover dot (hidden by default) -->
                  <circle id="chart-dot" cx="50" cy="50" r="3" fill="#ffffff" stroke="#855300" stroke-width="1.5" vector-effect="non-scaling-stroke" style="display:none"/>
                </svg>
                <!-- Vertical hover line -->
                <div id="chart-vline" class="absolute top-0 bottom-0 w-px bg-primary/30 pointer-events-none hidden" style="left:0"></div>
                <!-- Tooltip -->
                <div id="chart-tooltip" class="absolute hidden z-20 pointer-events-none" style="top:12px;left:0;min-width:130px">
                  <div class="bg-surface-container-lowest rounded-lg border border-outline-variant/30 shadow-lg px-3 py-2">
                    <p id="tip-date" class="font-label text-[10px] uppercase tracking-widest text-on-secondary-container mb-1"></p>
                    <p id="tip-revenue" class="font-headline text-lg text-on-surface leading-none"></p>
                  </div>
                </div>
              </div>
            </div>
            <!-- X-Axis labels row — left-padded to align with chart area -->
            <div class="flex justify-between text-xs font-label text-on-surface-variant mt-2" style="padding-left:3.5rem">
              <% if (xAxisLabels.length > 0) { %>
                <% xAxisLabels.forEach(function(lbl) { %><span><%= lbl %></span><% }); %>
              <% } else { %>
                <span>Day 1</span><span>Day <%= Math.round(selectedPeriod/2) %></span><span>Day <%= selectedPeriod %></span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Customer Insights Donut -->
        <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_20px_40px_rgba(25,28,30,0.06)] flex flex-col">
          <h2 class="font-headline text-xl text-on-surface mb-1">Customer Insights</h2>
          <p class="font-body text-sm text-on-secondary-container mb-8">New vs. Returning</p>
          <%
            const newPct = customerInsights ? customerInsights.newPct : 65;
            const retPct = customerInsights ? customerInsights.returningPct : 35;
            // SVG donut math: circle r=36, circumference = 2*PI*36 ≈ 226.19
            const circ = 2 * Math.PI * 36;
            const newDash = ((newPct / 100) * circ).toFixed(2);
            const retDash = ((retPct / 100) * circ).toFixed(2);
          %>
          <div class="flex-1 flex flex-col items-center justify-center">
            <!-- SVG donut -->
            <div class="relative w-48 h-48 flex items-center justify-center">
              <svg width="192" height="192" viewBox="0 0 96 96" class="absolute inset-0 -rotate-90">
                <!-- Track -->
                <circle cx="48" cy="48" r="36" fill="none" stroke="#e0e3e5" stroke-width="12"/>
                <!-- Returning arc (below new) -->
                <circle cx="48" cy="48" r="36" fill="none" stroke="#d8c3ad" stroke-width="12"
                  stroke-dasharray="<%= retDash %> <%= circ.toFixed(2) %>"
                  stroke-dashoffset="-<%= newDash %>"/>
                <!-- New arc -->
                <circle cx="48" cy="48" r="36" fill="none" stroke="#855300" stroke-width="12"
                  stroke-dasharray="<%= newDash %> <%= circ.toFixed(2) %>"/>
              </svg>
              <!-- Centre label -->
              <div class="flex flex-col items-center justify-center z-10">
                <span class="font-headline text-2xl text-on-surface leading-none"><%= newPct %>%</span>
                <span class="font-label text-xs text-on-surface-variant uppercase tracking-widest mt-1">New</span>
              </div>
            </div>

            <div class="w-full mt-8 flex flex-col gap-3">
              <div class="flex items-center justify-between text-sm font-body">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background:#855300"></div>
                  <span class="text-on-surface">New Customers</span>
                </div>
                <span class="font-medium text-on-surface"><%= newPct %>%</span>
              </div>
              <div class="flex items-center justify-between text-sm font-body">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background:#d8c3ad"></div>
                  <span class="text-on-surface">Returning</span>
                </div>
                <span class="font-medium text-on-surface"><%= retPct %>%</span>
              </div>
              <% if (customerInsights && customerInsights.total > 0) { %>
                <p class="text-xs text-on-surface-variant mt-1"><%= customerInsights.total %> unique customers this period</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Section: Best Selling & Categories -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Best Selling Table -->
        <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_20px_40px_rgba(25,28,30,0.06)]">
          <div class="flex justify-between items-center mb-6">
            <h2 class="font-headline text-2xl text-on-surface">Best Selling Pieces</h2>
            <a href="/artisan/products" class="font-headline text-sm italic text-on-surface hover:text-primary transition-colors underline decoration-outline-variant/50 underline-offset-4">View Full Inventory</a>
          </div>
          <% if (topProducts && topProducts.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-outline-variant/20">
                    <th class="pb-4 font-label text-xs uppercase tracking-widest text-on-secondary-container font-medium w-3/5">Item Name</th>
                    <th class="pb-4 font-label text-xs uppercase tracking-widest text-on-secondary-container font-medium text-right">Units</th>
                    <th class="pb-4 font-label text-xs uppercase tracking-widest text-on-secondary-container font-medium text-right">Revenue</th>
                  </tr>
                </thead>
                <tbody class="font-body text-sm text-on-surface">
                  <% topProducts.forEach(function(p, idx) {
                    let imgSrc = '/assets/placeholder.png';
                    try {
                      const imgs = JSON.parse(p.images || '[]');
                      if (imgs && imgs.length > 0) imgSrc = imgs[0];
                    } catch(e) {}
                  %>
                    <tr class="hover:bg-surface-container-low/50 transition-colors">
                      <td class="py-4 <%= idx < topProducts.length - 1 ? 'border-b border-outline-variant/10' : '' %>">
                        <div class="flex items-center gap-4">
                          <img src="<%= imgSrc %>" alt="<%= p.name %>" class="w-10 h-10 rounded object-cover shadow-sm bg-surface-container-high" onerror="this.src='/assets/placeholder.png'"/>
                          <span class="font-medium"><%= p.name %></span>
                        </div>
                      </td>
                      <td class="py-4 <%= idx < topProducts.length - 1 ? 'border-b border-outline-variant/10' : '' %> text-right text-on-secondary-container"><%= p.sold || 0 %></td>
                      <td class="py-4 <%= idx < topProducts.length - 1 ? 'border-b border-outline-variant/10' : '' %> text-right font-medium">$<%= Number(p.revenue || 0).toFixed(2) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="py-12 text-center text-on-secondary-container">
              <span class="material-symbols-outlined text-5xl opacity-40">inventory_2</span>
              <p class="mt-2 font-body text-sm">No product sales data yet.</p>
            </div>
          <% } %>
        </div>

        <!-- Sales by Category -->
        <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_20px_40px_rgba(25,28,30,0.06)]">
          <h2 class="font-headline text-2xl text-on-surface mb-8">Sales by Craft</h2>
          <% if (categoryBreakdown && categoryBreakdown.length > 0) { %>
            <div class="flex flex-col gap-6">
              <% const barHexColors = ['#855300','#545f73','#b02d29','#2e7d6b','#6750a4','#c47a00']; %>
              <% categoryBreakdown.forEach(function(cat, idx) { %>
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <div class="flex items-center gap-2">
                      <div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:<%= barHexColors[idx % barHexColors.length] %>"></div>
                      <span class="font-body text-sm font-medium text-on-surface"><%= cat.category %></span>
                    </div>
                    <span class="font-body text-sm font-medium text-on-surface"><%= cat.pct %>%</span>
                  </div>
                  <div class="w-full bg-surface-container-high rounded-full h-2">
                    <div class="h-2 rounded-full transition-all duration-500" style="width:<%= cat.pct %>%; background:<%= barHexColors[idx % barHexColors.length] %>"></div>
                  </div>
                </div>
              <% }); %>
            </div>
            <%
              const topCat = categoryBreakdown[0];
              const growingCat = categoryBreakdown.length > 1 ? categoryBreakdown[1] : null;
            %>
            <div class="mt-10 p-6 bg-surface-container-low rounded-lg border-l-2 border-primary">
              <p class="font-headline text-sm italic text-on-surface-variant">
                "<%= topCat.category %> leads your revenue at <%= topCat.pct %>% this period.<% if (growingCat) { %> <%= growingCat.category %> follows at <%= growingCat.pct %>%.<% } %>"
              </p>
            </div>
          <% } else { %>
            <div class="py-12 text-center text-on-secondary-container">
              <span class="material-symbols-outlined text-5xl opacity-40">donut_large</span>
              <p class="mt-2 font-body text-sm">No category data for this period.</p>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<script>
(function () {
  const data = <%- JSON.stringify(dailyRevenue || []) %>;
  if (!data.length) return;

  const wrapper  = document.getElementById('chart-wrapper');
  const tooltip  = document.getElementById('chart-tooltip');
  const vline    = document.getElementById('chart-vline');
  const tipDate  = document.getElementById('tip-date');
  const tipRev   = document.getElementById('tip-revenue');
  const dot      = document.getElementById('chart-dot');
  const svg      = document.getElementById('revenue-svg');
  if (!wrapper || !tooltip || !svg) return;

  // Pre-compute SVG-space x positions so we can snap to them
  const pts = data.map(function(d, i) {
    return {
      x: data.length === 1 ? 50 : (i / (data.length - 1)) * 100,
      y: 0, // not needed for hover
      day: d.day,
      revenue: d.revenue
    };
  });

  wrapper.addEventListener('mousemove', function (e) {
    const rect = wrapper.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const pct    = Math.max(0, Math.min(1, mouseX / rect.width));
    const idx    = Math.round(pct * (pts.length - 1));
    const pt     = pts[idx];
    if (!pt) return;

    // Date label
    const dtStr = pt.day.length === 10 ? pt.day + 'T12:00:00' : pt.day;
    const dt    = new Date(dtStr);
    tipDate.textContent = dt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
    tipRev.textContent  = '$' + Number(pt.revenue).toFixed(2);

    // Vertical line
    vline.style.left = mouseX + 'px';
    vline.classList.remove('hidden');

    // Move SVG dot to data point
    const svgX = pt.x.toFixed ? pt.x.toFixed(2) : pt.x;
    // recalculate y from revenue
    const maxRev = Math.max(...data.map(d => d.revenue));
    const svgY   = maxRev > 0 ? (10 + (1 - pt.revenue / maxRev) * 80).toFixed(2) : '80';
    dot.setAttribute('cx', svgX);
    dot.setAttribute('cy', svgY);
    dot.style.display = 'block';

    // Position tooltip (flip if near right edge)
    const tipW = 140;
    let tipX   = mouseX + 14;
    if (tipX + tipW > rect.width) tipX = mouseX - tipW - 14;
    tooltip.style.left = Math.max(0, tipX) + 'px';
    tooltip.classList.remove('hidden');
  });

  wrapper.addEventListener('mouseleave', function () {
    tooltip.classList.add('hidden');
    vline.classList.add('hidden');
    dot.style.display = 'none';
  });
})();
</script>

