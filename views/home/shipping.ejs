<%- include('../partials/header', { title: title }) %>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>

<main class="flex-grow py-20 px-4 md:px-8 max-w-4xl mx-auto w-full">
  <article class="bg-transparent">

    <!-- Page Header -->
    <header class="mb-12 text-center flex flex-col items-center">
      <div class="w-16 h-16 rounded-full bg-primary-container/10 flex items-center justify-center text-amber-600 mb-6 shadow-sm border border-primary-container/20">
        <span class="material-symbols-outlined text-3xl">local_shipping</span>
      </div>
      <h1 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-4 tracking-tight">Shipping &amp; Returns</h1>
      <p class="font-body text-secondary text-lg">Everything you need to know about delivery and our return process.</p>
    </header>

    <div class="space-y-6 font-body text-base text-on-surface/90 leading-relaxed">

      <!-- Intro Banner -->
      <section class="bg-surface-container-lowest rounded-2xl p-8 md:p-10 shadow-sm border border-outline-variant/30 text-center relative overflow-hidden mb-8">
        <div class="absolute inset-0 bg-primary-container/5 pointer-events-none"></div>
        <span class="material-symbols-outlined text-amber-600 text-4xl mb-4 relative z-10 block">package_2</span>
        <p class="text-lg relative z-10 text-secondary">
          Every Craftify order is prepared and shipped by the individual artisan. Processing times, shipping carriers, and return policies may vary slightly by shop — always check the product listing for seller-specific details.
        </p>
      </section>

      <!-- Section: Shipping -->
      <p class="font-headline text-sm font-bold uppercase tracking-widest text-amber-600 px-1">Shipping</p>

      <!-- Processing Times -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">schedule</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">Processing Times</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <p class="mb-4">Because each item is handmade to order, processing times vary by artisan and product. You'll find the estimated processing time on each product listing page.</p>
          <ul class="list-none space-y-3 mt-4">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">check_circle</span>
              <span><strong class="text-on-surface font-medium">Ready-made items:</strong> Typically dispatched within 1–3 business days.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">check_circle</span>
              <span><strong class="text-on-surface font-medium">Made-to-order items:</strong> May take 5–14 business days before shipping.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">check_circle</span>
              <span>Processing times exclude weekends and public holidays.</span>
            </li>
          </ul>
        </div>
      </details>

      <!-- Shipping Rates -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">payments</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">Shipping Rates</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <p class="mb-6">Shipping fees are calculated at checkout based on your location and order total:</p>
          <div class="rounded-xl overflow-hidden border border-outline-variant/20">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-surface-container-low">
                  <th class="text-left px-4 py-3 font-semibold text-on-surface">Order Total</th>
                  <th class="text-left px-4 py-3 font-semibold text-on-surface">Domestic Shipping</th>
                  <th class="text-left px-4 py-3 font-semibold text-on-surface">International</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline-variant/10">
                <tr>
                  <td class="px-4 py-3">Under $50</td>
                  <td class="px-4 py-3">$5.00 flat rate</td>
                  <td class="px-4 py-3">From $15.00</td>
                </tr>
                <tr class="bg-surface-container/30">
                  <td class="px-4 py-3">$50 and over</td>
                  <td class="px-4 py-3 text-amber-700 font-medium">Free</td>
                  <td class="px-4 py-3">From $12.00</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm">International rates vary by destination country and are estimated at checkout. Import duties and taxes may apply and are the buyer's responsibility.</p>
        </div>
      </details>

      <!-- Delivery Times -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">flight_takeoff</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">Estimated Delivery Times</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <p class="mb-4">After dispatch, estimated delivery windows are:</p>
          <ul class="list-none space-y-3">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">home</span>
              <span><strong class="text-on-surface font-medium">Domestic:</strong> 3–7 business days depending on your region.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">public</span>
              <span><strong class="text-on-surface font-medium">International:</strong> 7–21 business days. Delays may occur due to customs clearance.</span>
            </li>
          </ul>
          <p class="mt-4">You'll receive a tracking link via notification once your order ships. Track your order anytime from <strong class="text-on-surface font-medium">My Orders</strong> in your account.</p>
        </div>
      </details>

      <!-- Section: Returns -->
      <p class="font-headline text-sm font-bold uppercase tracking-widest text-amber-600 px-1 pt-4">Returns &amp; Refunds</p>

      <!-- Return Eligibility -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">assignment_return</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">Return Eligibility</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <p class="mb-4">We want you to love every purchase. Returns are accepted within <strong class="text-on-surface font-medium">14 days</strong> of confirmed delivery, provided:</p>
          <ul class="list-none space-y-3">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">check_circle</span>
              <span>The item is unused, undamaged, and in its original packaging.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">check_circle</span>
              <span>You have your order confirmation or receipt.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">cancel</span>
              <span><strong class="text-on-surface font-medium">Non-returnable:</strong> Custom or personalized items, perishable goods, and digital products cannot be returned unless they arrive damaged or defective.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">cancel</span>
              <span>Auction wins are final and cannot be returned unless the item arrives significantly not as described.</span>
            </li>
          </ul>
        </div>
      </details>

      <!-- How to Return -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">undo</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">How to Start a Return</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <ol class="list-none space-y-5 mt-2">
            <li class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">1</span>
              <span>Go to <strong class="text-on-surface font-medium">My Orders</strong> in your account and find the order you want to return.</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">2</span>
              <span>Click <strong class="text-on-surface font-medium">Request Return</strong> and select a reason from the dropdown.</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">3</span>
              <span>The artisan will review your request and respond within 2 business days with a return shipping label or instructions.</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">4</span>
              <span>Ship the item back securely. Once received and inspected, your refund will be processed within 5–7 business days.</span>
            </li>
          </ol>
        </div>
      </details>

      <!-- Damaged / Wrong Items -->
      <details class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 relative overflow-hidden group/details hover:border-amber-300/50 transition-colors duration-300">
        <div class="absolute top-0 left-0 w-2 h-full bg-amber-200 group-open/details:bg-amber-500 transition-colors duration-300 pointer-events-none"></div>
        <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none focus:outline-none">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-surface-container-low flex items-center justify-center text-amber-600 border border-outline-variant/20 shrink-0">
              <span class="material-symbols-outlined text-2xl">report_problem</span>
            </div>
            <h2 class="font-headline text-xl md:text-2xl font-bold text-on-surface m-0">Damaged or Wrong Items</h2>
          </div>
          <span class="material-symbols-outlined text-amber-600 text-3xl transform group-open/details:rotate-180 transition-transform duration-300 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 md:px-8 pb-6 md:pb-8 pt-0 text-secondary">
          <p class="mb-4">If your item arrives damaged, defective, or is not as described, please contact us within <strong class="text-on-surface font-medium">48 hours</strong> of delivery with:</p>
          <ul class="list-none space-y-3">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">photo_camera</span>
              <span>Clear photos of the item and packaging showing the damage.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">receipt</span>
              <span>Your order number.</span>
            </li>
          </ul>
          <p class="mt-4">We'll arrange a full refund or replacement at no cost to you. Return shipping for damaged or incorrect items is covered by Craftify.</p>
        </div>
      </details>

    </div>

    <!-- Contact CTA -->
    <div class="mt-12 p-8 bg-surface-container-low rounded-2xl border border-outline-variant/20 flex flex-col sm:flex-row justify-between items-center gap-6 shadow-sm">
      <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-amber-600 text-3xl">support_agent</span>
        <p class="font-body text-base font-medium text-on-surface">Need help with a shipment or return?</p>
      </div>
      <a class="inline-flex items-center justify-center px-8 py-3 bg-amber-600 hover:bg-amber-700 text-white font-label text-sm font-semibold rounded-full shadow-sm transition-colors duration-200" href="/contact">
        Contact Support
      </a>
    </div>

  </article>
</main>

<%- include('../partials/footer') %>
