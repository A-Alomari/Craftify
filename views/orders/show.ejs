<%- include('../partials/header', { title: title }) %>

<main class="flex-grow min-h-screen">

<%
  const orderStatusClass = function(status) {
    if (status === 'delivered') return 'bg-emerald-100 text-emerald-700';
    if (status === 'cancelled' || status === 'refunded') return 'bg-red-100 text-red-700';
    if (status === 'shipped' || status === 'processing') return 'bg-blue-100 text-blue-700';
    return 'bg-amber-100 text-amber-700';
  };
%>

<section class="max-w-7xl mx-auto px-6 py-10">
  <div class="mb-6">
    <a href="/orders" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-secondary hover:text-primary">
      <span class="material-symbols-outlined text-base">arrow_back</span>
      Back to Orders
    </a>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-headline text-3xl text-on-surface">Order #ORD-<%= String(order.id).padStart(4, '0') %></h1>
      <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest <%= orderStatusClass(order.status) %>"><%= order.status %></span>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="xl:col-span-2 bg-surface-container-lowest rounded-xl p-6 md:p-8">
      <h2 class="font-headline text-xl text-on-surface mb-4">Order Items</h2>

      <div class="space-y-3">
        <% items.forEach(function(item) { %>
          <article class="flex items-center justify-between gap-4 rounded-xl bg-surface-container-low px-4 py-3">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= item.image || '/images/placeholder-product.svg' %>" alt="<%= item.product_name %>" class="w-12 h-12 rounded-lg object-cover" onerror="this.onerror=null;this.src='/images/placeholder-product.svg'">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-on-surface truncate"><%= item.product_name %></p>
                <p class="text-xs text-secondary"><%= item.shop_name || '' %></p>
                <p class="text-xs text-secondary">$<%= Number(item.unit_price || 0).toFixed(2) %> x <%= item.quantity %></p>
                <% if (item.artisan_id) { %>
                  <a href="/user/messages/<%= item.artisan_id %>" class="inline-flex items-center gap-1 mt-1 text-[11px] font-semibold text-primary hover:underline">
                    <span class="material-symbols-outlined text-sm">chat</span>
                    Message Seller
                  </a>
                <% } %>
              </div>
            </div>
            <p class="text-sm font-bold text-on-surface">$<%= Number(item.total_price || 0).toFixed(2) %></p>
          </article>
        <% }); %>
      </div>

      <% if (['pending', 'confirmed'].indexOf(order.status) >= 0) { %>
        <form action="/orders/<%= order.id %>/cancel" method="POST" class="mt-6" data-confirm="Cancel this order?">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="bg-red-100 text-red-700 hover:bg-red-200 px-4 py-2.5 rounded-xl text-sm font-semibold">Cancel Order</button>
        </form>
      <% } %>

      <% if (order.status === 'delivered') { %>
        <div class="mt-6 pt-6 border-t border-surface-container-high">
          <h3 class="font-headline text-lg text-on-surface mb-4">Leave a Review</h3>
          <div class="space-y-4">
            <% items.forEach(function(item) { %>
              <% if (!item.product_id) return; %>
              <% if (item.hasReviewed) { %>
                <div class="flex items-center gap-3 p-4 rounded-xl bg-surface-container-low border border-surface-container-high">
                  <img src="<%= item.image %>" alt="<%= item.product_name %>" class="w-10 h-10 rounded-lg object-cover">
                  <div>
                    <p class="text-sm font-semibold text-on-surface"><%= item.product_name %></p>
                    <p class="text-xs text-secondary flex items-center gap-1 mt-0.5"><span class="material-symbols-outlined text-sm text-emerald-500">check_circle</span>You have reviewed this item</p>
                  </div>
                </div>
              <% } else if (item.canReview) { %>
                <details class="rounded-xl border border-outline-variant/25 bg-surface-container-low overflow-hidden">
                  <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-surface-container-high transition-colors">
                    <img src="<%= item.image %>" alt="<%= item.product_name %>" class="w-10 h-10 rounded-lg object-cover">
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold text-on-surface truncate"><%= item.product_name %></p>
                      <p class="text-xs text-primary">Tap to write a review</p>
                    </div>
                    <span class="material-symbols-outlined text-secondary text-lg">expand_more</span>
                  </summary>
                  <form action="/user/reviews" method="POST" class="px-4 pb-4 pt-2 space-y-3 border-t border-surface-container-high">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="product_id" value="<%= item.product_id %>">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <div>
                      <label class="block text-[10px] font-label uppercase tracking-[0.2em] text-secondary font-bold mb-1">Rating</label>
                      <div class="flex gap-1" id="stars-<%= item.product_id %>">
                        <% for (var s = 1; s <= 5; s++) { %>
                          <label class="cursor-pointer text-2xl select-none">
                            <input type="radio" name="rating" value="<%= s %>" class="sr-only" required>
                            <span class="star text-secondary/30 hover:text-amber-400 transition-colors" data-val="<%= s %>">★</span>
                          </label>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <label class="block text-[10px] font-label uppercase tracking-[0.2em] text-secondary font-bold mb-1">Title</label>
                      <input type="text" name="title" placeholder="Summarize your experience" class="w-full bg-surface-container-lowest border-none rounded-xl px-3 py-2 text-sm text-on-surface focus:ring-0" required maxlength="100">
                    </div>
                    <div>
                      <label class="block text-[10px] font-label uppercase tracking-[0.2em] text-secondary font-bold mb-1">Comment</label>
                      <textarea name="comment" rows="3" placeholder="Tell others about your experience..." class="w-full bg-surface-container-lowest border-none rounded-xl px-3 py-2 text-sm text-on-surface focus:ring-0 resize-none" required maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="bg-primary-container text-on-primary-container px-5 py-2 rounded-xl text-sm font-bold hover:opacity-90">Submit Review</button>
                  </form>
                </details>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% } %>
    </section>

    <aside class="space-y-6">
      <article class="bg-surface-container-lowest rounded-xl p-6">
        <h2 class="font-headline text-lg text-on-surface mb-3">Order Summary</h2>
        <div class="space-y-2 text-sm text-on-surface">
          <div class="flex justify-between"><span class="text-secondary">Subtotal</span><span>$<%= Number(order.subtotal || 0).toFixed(2) %></span></div>
          <div class="flex justify-between"><span class="text-secondary">Shipping</span><span>$<%= Number(order.shipping_cost || 0).toFixed(2) %></span></div>
          <% if (order.discount_amount > 0) { %>
            <div class="flex justify-between text-emerald-700"><span>Discount</span><span>-$<%= Number(order.discount_amount || 0).toFixed(2) %></span></div>
          <% } %>
        </div>
        <div class="mt-4 pt-4 border-t border-surface-container-high flex justify-between items-center">
          <span class="text-xs uppercase tracking-[0.2em] text-secondary font-bold">Total</span>
          <span class="font-headline text-2xl text-on-surface">$<%= Number(order.total_amount || 0).toFixed(2) %></span>
        </div>
      </article>

      <article class="bg-surface-container-lowest rounded-xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="material-symbols-outlined text-primary">local_shipping</span>
          <h2 class="font-headline text-lg text-on-surface">Shipping</h2>
        </div>
        <div class="rounded-xl bg-surface-container-low p-4 border border-surface-container-high">
          <p class="text-sm font-semibold text-on-surface"><%= order.shipping_address %></p>
          <p class="text-sm text-secondary mt-1"><%= order.shipping_city || '' %> <%= order.shipping_country || '' %></p>
          <% if (order.shipping_postal) { %>
            <p class="text-xs text-secondary mt-1">Postal code: <%= order.shipping_postal %></p>
          <% } %>
        </div>

        <% if (shipment) { %>
          <div class="mt-4 pt-4 border-t border-surface-container-high">
            <p class="text-sm text-on-surface"><span class="font-semibold">Tracking:</span> <%= shipment.tracking_number %></p>
            <p class="text-sm text-on-surface mt-1"><span class="font-semibold">Status:</span> <%= shipment.status %></p>
            <a href="/orders/<%= order.id %>/track" class="inline-block mt-3 bg-primary-container text-on-primary-container px-4 py-2 rounded-lg text-xs font-semibold">Track Order</a>
          </div>
        <% } else { %>
          <p class="text-xs text-secondary mt-4">Tracking details will appear here once the artisan dispatches the package.</p>
        <% } %>
      </article>
    </aside>
  </div>
</section>

</main>

<%- include('../partials/footer') %>

<script>
// Star rating interactive highlight
document.querySelectorAll('[id^="stars-"]').forEach(function(container) {
  var stars = container.querySelectorAll('.star');
  var inputs = container.querySelectorAll('input[type="radio"]');
  stars.forEach(function(star, i) {
    star.addEventListener('mouseenter', function() {
      stars.forEach(function(s, j) { s.style.color = j <= i ? '#f59e0b' : ''; });
    });
    star.addEventListener('mouseleave', function() {
      var checked = container.querySelector('input:checked');
      var val = checked ? parseInt(checked.value) - 1 : -1;
      stars.forEach(function(s, j) { s.style.color = j <= val ? '#f59e0b' : ''; });
    });
    inputs[i].addEventListener('change', function() {
      stars.forEach(function(s, j) { s.style.color = j <= i ? '#f59e0b' : ''; });
    });
  });
});
</script>
