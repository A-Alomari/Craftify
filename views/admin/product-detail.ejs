<%- include('../partials/header', { title: title }) %>

<div class="flex bg-surface min-h-screen">
  <%- include('./partials/sidebar') %>

  <main class="flex-1 min-h-screen px-6 lg:px-8 py-8">
    <%- include('./partials/topbar') %>

    <section class="max-w-5xl mx-auto mt-8 mb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <a href="/admin/products" class="text-xs uppercase tracking-[0.2em] text-secondary hover:text-primary">&larr; Back to Products</a>
        <h1 class="font-headline text-3xl text-on-surface mt-2"><%= product.name %></h1>
        <p class="text-secondary mt-1">ID: <%= product.id %> &bull; by <%= product.shop_name || product.artisan_name || 'Unknown' %></p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest <%= product.status === 'approved' ? 'bg-emerald-100 text-emerald-700' : (product.status === 'pending' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700') %>"><%= product.status %></span>
        <% if (product.featured) { %>
          <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest bg-amber-100 text-amber-700">&#9733; Featured</span>
        <% } %>
      </div>
    </section>

    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-6">
      <!-- Images -->
      <section class="lg:col-span-3 bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm">
        <% if (images && images.length > 0) { %>
          <div class="grid grid-cols-1 gap-2 p-4">
            <img src="<%= images[0] %>" alt="<%= product.name %>" class="w-full rounded-lg object-cover max-h-80" onerror="this.onerror=null;this.src='/images/placeholder-product.svg'">
            <% if (images.length > 1) { %>
              <div class="flex gap-2 overflow-x-auto">
                <% images.slice(1).forEach(function(img) { %>
                  <img src="<%= img %>" alt="<%= product.name %>" class="h-20 w-20 rounded-lg object-cover shrink-0 cursor-pointer hover:opacity-80 transition-opacity" onerror="this.onerror=null;this.src='/images/placeholder-product.svg'">
                <% }); %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="flex items-center justify-center h-64 bg-surface-container-low">
            <span class="material-symbols-outlined text-5xl text-secondary/40">image_not_supported</span>
          </div>
        <% } %>
      </section>

      <!-- Details + Actions -->
      <section class="lg:col-span-2 space-y-4">
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm space-y-3">
          <h2 class="text-xs uppercase tracking-[0.2em] text-secondary font-bold">Details</h2>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-secondary">Price</span><span class="font-semibold text-on-surface">$<%= Number(product.price || 0).toFixed(2) %></span></div>
            <div class="flex justify-between"><span class="text-secondary">Stock</span><span class="font-semibold text-on-surface"><%= product.stock %></span></div>
            <div class="flex justify-between"><span class="text-secondary">Category</span><span class="font-semibold text-on-surface"><%= product.category_name || '-' %></span></div>
            <div class="flex justify-between"><span class="text-secondary">Shop</span><span class="font-semibold text-on-surface"><%= product.shop_name || '-' %></span></div>
            <div class="flex justify-between"><span class="text-secondary">Artisan</span><span class="font-semibold text-on-surface"><%= product.artisan_name || '-' %></span></div>
            <div class="flex justify-between"><span class="text-secondary">Avg Rating</span><span class="font-semibold text-on-surface"><%= product.avg_rating ? Number(product.avg_rating).toFixed(1) + ' &#9733;' : 'N/A' %></span></div>
          </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm">
          <h2 class="text-xs uppercase tracking-[0.2em] text-secondary font-bold mb-3">Description</h2>
          <p class="text-sm text-on-surface leading-relaxed"><%= product.description || 'No description provided.' %></p>
        </div>

        <!-- Admin Actions -->
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm space-y-2">
          <h2 class="text-xs uppercase tracking-[0.2em] text-secondary font-bold mb-3">Admin Actions</h2>
          <% if (product.status === 'pending' || product.status === 'rejected') { %>
            <form action="/admin/products/<%= product.id %>/approve" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="w-full flex items-center justify-center gap-2 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 px-4 py-2.5 rounded-xl text-sm font-bold transition-colors">
                <span class="material-symbols-outlined text-[18px]">check_circle</span> Approve Product
              </button>
            </form>
          <% } %>
          <% if (product.status === 'pending') { %>
            <form action="/admin/products/<%= product.id %>/reject" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="w-full flex items-center justify-center gap-2 bg-amber-100 text-amber-700 hover:bg-amber-200 px-4 py-2.5 rounded-xl text-sm font-bold transition-colors">
                <span class="material-symbols-outlined text-[18px]">cancel</span> Reject Product
              </button>
            </form>
          <% } %>
          <% if (product.status === 'approved') { %>
            <form action="/admin/products/<%= product.id %>/featured" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="w-full flex items-center justify-center gap-2 <%= product.featured ? 'bg-amber-100 text-amber-700 hover:bg-amber-200' : 'bg-surface-container-high text-secondary hover:bg-surface-container-highest' %> px-4 py-2.5 rounded-xl text-sm font-bold transition-colors">
                <span class="material-symbols-outlined text-[18px]"><%= product.featured ? 'star' : 'star_border' %></span>
                <%= product.featured ? 'Remove Featured' : 'Mark as Featured' %>
              </button>
            </form>
          <% } %>
          <form action="/admin/products/<%= product.id %>/delete" method="POST" data-confirm="Delete this product permanently?">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="w-full flex items-center justify-center gap-2 bg-red-100 text-red-700 hover:bg-red-200 px-4 py-2.5 rounded-xl text-sm font-bold transition-colors">
              <span class="material-symbols-outlined text-[18px]">delete</span> Delete Product
            </button>
          </form>
        </div>
      </section>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
