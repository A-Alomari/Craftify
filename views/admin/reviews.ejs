<%- include('../partials/header', { title: title }) %>
<%
  const statusFilter = filters && filters.status ? filters.status : '';
  const ratingFilter = filters && filters.rating ? String(filters.rating) : '';
  const searchFilter = filters && filters.search ? filters.search : '';
  const stats = reviewStats || { total: 0, pending: 0, avgRating: '0.0' };
%>

<div class="flex flex-col lg:flex-row bg-surface min-h-screen">
  <%- include('./partials/sidebar') %>

  <main class="flex-1 min-w-0 min-h-screen px-6 lg:px-8 py-8 overflow-x-hidden">
    <%- include('./partials/topbar') %>

    <div class="max-w-7xl mx-auto space-y-8 mt-8">

      <!-- Page Header -->
      <div class="flex flex-col gap-1">
        <span class="font-label text-xs tracking-[0.2em] text-primary font-semibold uppercase">Administration</span>
        <h1 class="font-headline text-4xl text-on-surface font-bold">Review Moderation</h1>
        <p class="font-body text-secondary text-base">Monitor and manage customer feedback across the platform.</p>
      </div>

      <!-- Summary Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Total Reviews -->
        <div class="bg-surface-container-lowest p-6 rounded-xl relative overflow-hidden group">
          <div class="absolute -right-4 -top-4 w-24 h-24 bg-surface-container-low rounded-full opacity-50 group-hover:scale-110 transition-transform duration-500"></div>
          <p class="font-label text-xs text-secondary uppercase tracking-wider mb-2">Total Reviews</p>
          <p class="font-headline text-3xl font-bold text-on-surface"><%= stats.total %></p>
          <div class="mt-4 flex items-center text-sm text-secondary">
            <span class="material-symbols-outlined text-sm mr-1">rate_review</span> All time
          </div>
        </div>

        <!-- Pending -->
        <div class="bg-surface-container-lowest p-6 rounded-xl relative overflow-hidden border-l-4 border-amber-500 group">
          <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary-fixed rounded-full opacity-20 group-hover:scale-110 transition-transform duration-500"></div>
          <p class="font-label text-xs text-secondary uppercase tracking-wider mb-2">Pending Approval</p>
          <p class="font-headline text-3xl font-bold text-amber-700"><%= stats.pending %></p>
          <div class="mt-4 flex items-center text-sm text-amber-600">
            <span class="material-symbols-outlined text-sm mr-1">schedule</span>
            <%= stats.pending > 0 ? 'Needs attention' : 'All clear' %>
          </div>
        </div>

        <!-- Average Rating -->
        <div class="bg-surface-container-lowest p-6 rounded-xl relative overflow-hidden group">
          <div class="absolute -right-4 -top-4 w-24 h-24 bg-secondary-container rounded-full opacity-30 group-hover:scale-110 transition-transform duration-500"></div>
          <p class="font-label text-xs text-secondary uppercase tracking-wider mb-2">Average Rating</p>
          <div class="flex items-baseline gap-2">
            <p class="font-headline text-3xl font-bold text-on-surface"><%= stats.avgRating %></p>
            <span class="material-symbols-outlined text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <div class="mt-4 flex items-center text-sm text-secondary">
            Across all products
          </div>
        </div>
      </div>

      <!-- Filter & Search Row -->
      <form method="GET" action="/admin/reviews" class="bg-surface-container-lowest p-4 rounded-xl flex flex-col lg:flex-row gap-4 items-center justify-between">
        <div class="flex-1 w-full relative">
          <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-secondary">search</span>
          <input
            name="search"
            value="<%= searchFilter %>"
            class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-transparent rounded-lg focus:bg-surface-container-highest focus:ring-0 focus:border-l-2 focus:border-primary transition-all font-body text-sm text-on-surface placeholder-secondary"
            placeholder="Search by product, reviewer, or content..."
            type="text"
          />
        </div>
        <div class="flex flex-wrap gap-3 w-full lg:w-auto items-center">
          <select name="status" class="bg-surface-container-low border-transparent rounded-lg py-3 px-4 font-body text-sm text-on-surface focus:ring-0 focus:bg-surface-container-highest cursor-pointer">
            <option value="">Status: All</option>
            <option value="visible" <%= statusFilter === 'visible' ? 'selected' : '' %>>Approved</option>
            <option value="hidden" <%= statusFilter === 'hidden' ? 'selected' : '' %>>Pending</option>
          </select>
          <select name="rating" class="bg-surface-container-low border-transparent rounded-lg py-3 px-4 font-body text-sm text-on-surface focus:ring-0 focus:bg-surface-container-highest cursor-pointer">
            <option value="">Rating: All</option>
            <option value="5" <%= ratingFilter === '5' ? 'selected' : '' %>>5 Stars</option>
            <option value="4" <%= ratingFilter === '4' ? 'selected' : '' %>>4 Stars</option>
            <option value="3" <%= ratingFilter === '3' ? 'selected' : '' %>>3 Stars</option>
            <option value="2" <%= ratingFilter === '2' ? 'selected' : '' %>>2 Stars</option>
            <option value="1" <%= ratingFilter === '1' ? 'selected' : '' %>>1 Star</option>
          </select>
          <button type="submit" class="bg-primary-container text-on-primary-container px-6 py-3 rounded-lg font-medium text-sm hover:opacity-90 transition-opacity">
            Apply
          </button>
          <a href="/admin/reviews" class="bg-surface-container-high text-on-surface px-6 py-3 rounded-lg font-medium text-sm hover:bg-surface-container-highest transition-colors">
            Reset
          </a>
        </div>
      </form>

      <!-- Reviews Table -->
      <div class="bg-surface-container-lowest rounded-xl overflow-hidden">
        <% if (reviews && reviews.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left font-body text-sm">
              <thead class="bg-surface-container-low text-secondary border-b-2 border-surface">
                <tr>
                  <th class="px-6 py-4 font-medium">Product &amp; Artisan</th>
                  <th class="px-6 py-4 font-medium">Reviewer</th>
                  <th class="px-6 py-4 font-medium">Rating</th>
                  <th class="px-6 py-4 font-medium w-1/3">Review Content</th>
                  <th class="px-6 py-4 font-medium">Status</th>
                  <th class="px-6 py-4 font-medium text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-surface-container-low">
                <% reviews.forEach(function(r) { %>
                  <tr class="hover:bg-surface-container-low/50 transition-colors">

                    <!-- Product & Artisan -->
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-3">
                        <% if (r.product_image) { %>
                          <img
                            src="<%= r.product_image %>"
                            alt="<%= r.product_name %>"
                            class="w-11 h-11 rounded-lg object-cover flex-shrink-0 bg-surface-container-low"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                          />
                          <div class="w-11 h-11 rounded-lg bg-surface-container-low flex items-center justify-center flex-shrink-0" style="display:none;">
                            <span class="material-symbols-outlined text-secondary text-lg">inventory_2</span>
                          </div>
                        <% } else { %>
                          <div class="w-11 h-11 rounded-lg bg-surface-container-low flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-secondary text-lg">inventory_2</span>
                          </div>
                        <% } %>
                        <div class="min-w-0">
                          <p class="font-semibold text-on-surface truncate"><%= r.product_name %></p>
                          <% if (r.artisan_shop) { %>
                            <p class="text-xs text-secondary truncate">by <%= r.artisan_shop %></p>
                          <% } %>
                        </div>
                      </div>
                    </td>

                    <!-- Reviewer -->
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-2">
                        <% if (r.reviewer_avatar) { %>
                          <img
                            src="<%= r.reviewer_avatar %>"
                            alt="<%= r.reviewer_name %>"
                            class="w-8 h-8 rounded-full object-cover flex-shrink-0"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                          />
                          <div class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold text-xs flex-shrink-0" style="display:none;">
                            <%= r.reviewer_name ? r.reviewer_name.charAt(0).toUpperCase() : '?' %>
                          </div>
                        <% } else { %>
                          <div class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold text-xs flex-shrink-0">
                            <%= r.reviewer_name ? r.reviewer_name.charAt(0).toUpperCase() : '?' %>
                          </div>
                        <% } %>
                        <span class="text-on-surface font-medium whitespace-nowrap"><%= r.reviewer_name %></span>
                      </div>
                    </td>

                    <!-- Rating Stars -->
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-0.5 text-amber-500">
                        <% const rating = Number(r.rating || 0); %>
                        <% for (let s = 1; s <= 5; s++) { %>
                          <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' <%= s <= rating ? 1 : 0 %>;">star</span>
                        <% } %>
                        <span class="ml-1 text-xs font-semibold text-on-surface"><%= rating %></span>
                      </div>
                    </td>

                    <!-- Review Content -->
                    <td class="px-6 py-4 text-secondary max-w-xs">
                      <% if (r.title) { %>
                        <p class="font-medium text-on-surface text-xs mb-0.5 truncate"><%= r.title %></p>
                      <% } %>
                      <p class="line-clamp-2 text-xs"><%= r.comment || '—' %></p>
                    </td>

                    <!-- Status Badge -->
                    <td class="px-6 py-4">
                      <% if (r.is_approved) { %>
                        <span class="inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          Approved
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                          <span class="material-symbols-outlined text-[14px]">schedule</span>
                          Pending
                        </span>
                      <% } %>
                    </td>

                    <!-- Actions -->
                    <td class="px-6 py-4 text-right">
                      <div class="flex justify-end gap-1.5">
                        <% if (!r.is_approved) { %>
                          <form action="/admin/reviews/<%= r.id %>/approve" method="POST" class="inline-block">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="Approve">
                              <span class="material-symbols-outlined text-xl">check_circle</span>
                            </button>
                          </form>
                        <% } %>
                        <form action="/admin/reviews/<%= r.id %>/delete" method="POST" class="inline-block" data-confirm="Delete this review?">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                          <button class="p-1.5 text-tertiary hover:bg-error-container rounded-lg transition-colors" title="Delete">
                            <span class="material-symbols-outlined text-xl">delete</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Table Footer -->
          <div class="border-t-2 border-surface bg-surface-container-lowest px-6 py-4 flex items-center justify-between">
            <span class="text-sm text-secondary">Showing <%= reviews.length %> of <%= reviewStats.total %> reviews</span>
            <div class="flex items-center gap-1 text-sm text-secondary">
              <span class="material-symbols-outlined text-sm">info</span>
              <span>Use filters to narrow results</span>
            </div>
          </div>
          <%- include('../partials/pagination', {
            pagination: pagination,
            queryString: [filters.status ? 'status=' + filters.status : '', filters.rating ? 'rating=' + filters.rating : '', filters.search ? 'search=' + encodeURIComponent(filters.search) : ''].filter(Boolean).join('&')
          }) %>

        <% } else { %>
          <div class="py-16 text-center">
            <span class="material-symbols-outlined text-6xl text-secondary/40">rate_review</span>
            <p class="text-secondary mt-4 font-medium">No reviews found for this filter.</p>
            <a href="/admin/reviews" class="mt-3 inline-block text-primary text-sm hover:underline">Clear filters</a>
          </div>
        <% } %>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
