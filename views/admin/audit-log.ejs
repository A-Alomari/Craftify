<%- include('../partials/header', { title: title }) %>

<div class="flex flex-col lg:flex-row bg-surface min-h-screen">
  <%- include('./partials/sidebar') %>

  <main class="flex-1 min-h-screen px-6 lg:px-10 py-8">
    <%- include('./partials/topbar') %>

    <div class="max-w-5xl mx-auto mt-8">

      <!-- Page Header -->
      <div class="flex flex-col gap-3 mb-10">
        <span class="font-label text-xs tracking-[0.2em] text-primary font-semibold uppercase">Administration · Settings</span>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="font-headline text-4xl font-black leading-tight tracking-[-0.033em] text-on-surface">Activity Ledger</h1>
            <p class="text-secondary text-base mt-2 max-w-xl">A chronological, immutable record of every administrative action performed on the platform.</p>
          </div>
          <a href="/admin/settings" class="shrink-0 inline-flex items-center gap-2 bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-semibold py-2.5 px-5 rounded-xl transition-colors text-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back to Settings
          </a>
        </div>
      </div>

      <!-- Summary row -->
      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-surface-container-lowest rounded-xl p-5">
          <p class="text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Total Actions</p>
          <p class="font-headline text-3xl font-bold text-on-surface mt-1"><%= pagination.total %></p>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-5">
          <p class="text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Current Page</p>
          <p class="font-headline text-3xl font-bold text-on-surface mt-1"><%= pagination.page %> / <%= pagination.totalPages || 1 %></p>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-5">
          <p class="text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Per Page</p>
          <p class="font-headline text-3xl font-bold text-on-surface mt-1"><%= pagination.limit %></p>
        </div>
      </div>

      <!-- Log Table -->
      <div class="bg-surface-container-lowest rounded-xl overflow-hidden mb-8">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left border-b border-surface-container-high">
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">Action</th>
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">Admin</th>
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">Target</th>
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">Detail</th>
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">IP</th>
                <th class="px-5 py-4 font-label text-[10px] uppercase tracking-[0.15em] text-secondary font-semibold whitespace-nowrap">Timestamp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-container-low">
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(function(entry) { %>
                  <tr class="hover:bg-surface-container-low/50 transition-colors">
                    <td class="px-5 py-4 font-medium text-on-surface whitespace-nowrap"><%= entry.action_label %></td>
                    <td class="px-5 py-4 text-secondary whitespace-nowrap"><%= entry.admin_name || '—' %></td>
                    <td class="px-5 py-4 text-secondary whitespace-nowrap">
                      <% if (entry.entity_type) { %>
                        <span class="capitalize"><%= entry.entity_type %></span><% if (entry.entity_id) { %> #<%= entry.entity_id %><% } %>
                      <% } else { %>—<% } %>
                    </td>
                    <td class="px-5 py-4 text-secondary max-w-[200px] truncate"><%= entry.detail_text || '—' %></td>
                    <td class="px-5 py-4 text-secondary font-mono text-xs whitespace-nowrap"><%= entry.ip_address || '—' %></td>
                    <td class="px-5 py-4 text-secondary whitespace-nowrap text-xs">
                      <%= new Date(entry.created_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-5 py-16 text-center text-secondary italic">No activity recorded yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-center gap-2 mb-12">
          <% if (pagination.page > 1) { %>
            <a href="?page=<%= pagination.page - 1 %>" class="px-4 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface-variant text-sm font-medium transition-colors">Previous</a>
          <% } %>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <a href="?page=<%= p %>"
              class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-medium transition-colors <%- p === pagination.page ? 'bg-primary-container text-on-primary-container' : 'bg-surface-container-low hover:bg-surface-container text-on-surface-variant' %>">
              <%= p %>
            </a>
          <% } %>
          <% if (pagination.page < pagination.totalPages) { %>
            <a href="?page=<%= pagination.page + 1 %>" class="px-4 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface-variant text-sm font-medium transition-colors">Next</a>
          <% } %>
        </div>
      <% } %>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
