# ─────────────────────────────────────────────────────────────────────────────
# Craftify — Environment Variables
# Copy to .env and fill in the values before starting the app.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=false
RUN_BACKGROUND_TASKS=true

# Localisation
APP_CURRENCY=BHD
APP_LOCALE=en-BH

# CORS (comma-separated origins, or * for open)
CORS_ORIGIN=http://localhost:3000

# Database (SQLite file path; use :memory: for ephemeral)
DB_PATH=./craftify.db
# Backward-compatible alias used by older builds
CRAFTIFY_DB_PATH=./craftify.db

# Session
SESSION_SECRET=change-me-to-a-long-random-secret-32-chars-min
SESSION_FILE_SECRET=change-me-session-file-secret
SESSION_STORE_PATH=./.sessions

# File Uploads
UPLOAD_DIR=./uploads

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP
# Used by src/config/mail.config.ts
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@craftify.com
SMTP_FROM_NAME=Craftify

# Legacy aliases (used by some auth helpers — keep in sync with SMTP_* above)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Craftify <noreply@craftify.com>

# Set to true to open a browser preview for outgoing emails in development
MAIL_PREVIEW=false

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=6
ENABLE_NON_PROD_CSP=false

# ─────────────────────────────────────────────────────────────────────────────
# Socket.IO — Auction bid rate limiting
# ─────────────────────────────────────────────────────────────────────────────
SOCKET_BID_WINDOW_MS=60000
SOCKET_BID_MAX_PER_WINDOW=12
SOCKET_BID_BLOCK_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Payment
# ALLOW_MOCK_PAYMENTS=true allows test card numbers (dev/staging only)
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_MOCK_PAYMENTS=true
