{
  "name": "craftify",
  "version": "1.0.0",
  "description": "E-commerce platform for local artisans",
  "main": "dist/main",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "npx tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "seed": "ts-node src/database/seeds/seed.ts",
    "test": "jest --runInBand --forceExit --detectOpenHandles --verbose",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles --runInBand",
    "test:controllers": "jest --runInBand test/controllers",
    "test:models": "jest --runInBand test/models",
    "test:views": "jest --runInBand test/views"
  },
  "keywords": [
    "e-commerce",
    "artisan",
    "marketplace"
  ],
  "author": "ITCS489 Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs-modules/mailer": "^1.11.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/serve-static": "^4.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.0",
    "ejs": "^3.1.9",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "session-file-store": "^1.5.0",
    "socket.io": "^4.7.4",
    "sql.js": "^1.10.3",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/method-override": "^0.0.32",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
