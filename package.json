{
  "name": "craftify",
  "version": "1.0.0",
  "description": "E-commerce platform for local artisans",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seed.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles --verbose",
    "test:coverage": "jest --runInBand --coverage --forceExit --detectOpenHandles",
    "test:controllers": "jest --runInBand tests/controllers.suite.js --forceExit",
    "test:models": "jest --runInBand tests/models.suite.js --forceExit",
    "test:views": "jest --runInBand tests/views.suite.js --forceExit",
    "test:routes": "jest --runInBand tests/routes/ --forceExit --detectOpenHandles --verbose",
    "test:middleware": "jest --runInBand tests/middleware/ --forceExit --verbose",
    "test:services": "jest --runInBand tests/services/ --forceExit --verbose",
    "test:new": "jest --runInBand tests/routes/ tests/middleware/ tests/services/ --forceExit --detectOpenHandles --verbose"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/craftify.test.js",
      "**/tests/bug-fixes.test.js",
      "**/tests/full-audit.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 75,
        "functions": 80,
        "statements": 80
      }
    },
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "!**/node_modules/**"
    ],
    "testTimeout": 30000
  },
  "keywords": [
    "e-commerce",
    "artisan",
    "marketplace"
  ],
  "author": "ITCS489 Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "session-file-store": "^1.5.0",
    "socket.io": "^4.7.4",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
